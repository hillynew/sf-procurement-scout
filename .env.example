# Optional: read bid notices from a subscribed mailbox.
#
# No portal in this project offers webhooks. CivicPlus cities do offer a
# "Notify Me" email subscription, so pointing the app at a dedicated mailbox
# is the closest thing to a real-time push feed.
#
# Subscribe the mailbox at each city's /list.aspx?Mode=Subscribe#bids page,
# then set these. Leave them unset and the source reports "inactive" and the
# app behaves exactly as before.
#
# Use a dedicated mailbox and an app-specific password, never a primary
# account password. The mailbox is opened read-only; nothing is ever deleted.

SF_SCOUT_IMAP_HOST=imap.gmail.com
SF_SCOUT_IMAP_USER=bids@example.com
SF_SCOUT_IMAP_PASSWORD=your-app-specific-password
# SF_SCOUT_IMAP_FOLDER=INBOX
# SF_SCOUT_IMAP_DAYS=30

# Optional: surface solicitations a signed-in Bonfire vendor account was
# invited to or is following — invisible to an anonymous scrape.
#
# Sign in to the agency's Bonfire portal in a browser, open dev tools'
# Network tab, and copy the Cookie header from any request to the portal.
# Session cookies expire; when yours does, the source quietly falls back to
# the public listing rather than failing — `python run.py auth-status` shows
# which hosts currently have a session configured (never the cookie itself).

# SF_SCOUT_BONFIRE_COOKIE=paste-the-whole-cookie-header-here
# SF_SCOUT_BONFIRE_COOKIE_BROWARD=alternate-cookie-scoped-to-one-host-only

# --- Federal bids (SAM.gov) --------------------------------------------------
# Free API key from https://sam.gov (Account Details -> API Key) or api.data.gov.
# Enables the "SAM.gov federal bids (Florida)" source.
# SF_SCOUT_SAM_KEY=your-sam-gov-api-key

# --- AI deal briefs (Claude API) ---------------------------------------------
# SF_SCOUT_ANTHROPIC_KEY=sk-ant-...

# --- Email digests (Resend) --------------------------------------------------
# Free key from https://resend.com. Recipient can also be set in Settings,
# which wins over SF_SCOUT_DIGEST_TO.
#
# SF_SCOUT_DIGEST_FROM defaults to Resend's shared onboarding@resend.dev, which
# only delivers to the address that owns the Resend account — verify your own
# domain in Resend to send anywhere else.
#
# Confirm it end to end with `python run.py test-email` (or Settings → Email
# digest → Send test email) before trusting a scheduled digest.
# RESEND_API_KEY=re_...
# SF_SCOUT_DIGEST_TO=you@company.com
# SF_SCOUT_DIGEST_FROM=Scout <scout@yourdomain.com>

# --- Crawl policy (src/netpolicy.py) ---------------------------------------
# The crawler identifies itself honestly and points at a contact. Set this to a
# real inbox or page so an administrator who notices the traffic can reach you.
# SF_SCOUT_CONTACT=https://example.com/crawler

# Obey robots.txt everywhere, dropping the documented exceptions in
# ROBOTS_OVERRIDES. Costs the 30 Bonfire tenants (Broward, Hillsborough,
# Tallahassee, Monroe...), so it is off by default and is a deliberate choice
# either way — see docs/statewide-coverage.md.
# SF_SCOUT_STRICT_ROBOTS=1

# Append one JSON object per HTTP request: URL, time, status, and what
# robots.txt said at the time. Unset disables it. This is the defense file, and
# it is only useful if it was already running before anyone asks for it.
# SF_SCOUT_FETCH_LOG=data/fetches.jsonl
